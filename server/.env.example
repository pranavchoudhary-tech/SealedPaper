# ---------- SealedPaper API settings ----------
# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection.
# Local (docker compose up -d):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sealedpaper
# Supabase: Project > Connect > "Session pooler" (port 5432). It looks like
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Use the Session pooler, not "Direct connection" (IPv6 only, Render cannot reach it)
# and not "Transaction pooler" (port 6543, breaks transactions and advisory locks).
# SSL is switched on automatically for any non-local host. Force it with DATABASE_SSL=true|false.
# Connections the API keeps open (Supabase free pooler allows about 15 in total)
DB_POOL_MAX=10

# Generate both with: npm run keygen
MASTER_KEY=
JWT_SECRET=

PORT=4000
APP_NAME=SealedPaper
MAX_UPLOAD_MB=4

# Face verification: "real" runs the face models (use this). "mock" is only for automated tests.
FACE_MODE=real
# Tuning (defaults shown). Lower FACE_MATCH_THRESHOLD = stricter.
FACE_MATCH_THRESHOLD=0.5
FACE_CONSISTENCY_THRESHOLD=0.6
FACE_STRAIGHT_MAX_YAW=0.15
FACE_TURN_MIN_YAW=0.2
FACE_MIN_WIDTH_PX=80

# Failed key uploads allowed per custodian per document in 10 minutes
KEY_MAX_FAILURES=5
# Run the release worker inside the API process
RUN_WORKER=true
# Proxies between the browser and this API: 1 locally (Next.js), 2 for Vercel -> Render
TRUST_PROXY=1
# Set to production when deployed (forces secure cookies, forbids FACE_MODE=mock)
NODE_ENV=development
